# Clave secreta para firmar la sesión. Genérala con: npx auth secret
# (npx auth secret la agrega automáticamente al final de este archivo)

# GitHub: credenciales de github.com/settings/developers -> OAuth Apps
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# PRÁCTICA - Twitch: credenciales de dev.twitch.tv/console/apps
# URL de redireccionamiento: http://localhost:3000/api/auth/callback/twitch
# AUTH_TWITCH_ID=
# AUTH_TWITCH_SECRET=
